# Copy to .env (or export these) before `npm start`.
# Pick ONE provider by setting its API key. With no key set, the backend runs in
# OFFLINE STUB MODE: it still generates valid, safe plans deterministically, but
# AI chat is disabled.

# --- OpenAI (default if its key is present) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Force a provider regardless of which keys are set: openai | anthropic
# FITPLUS_PROVIDER=openai

# Server port
PORT=8080
